[Unit]
Description=Viikko 4 Flask-sovellus
After=network.target mariadb.service
Requires=mariadb.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/viikko4/app
EnvironmentFile=/etc/viikko4.env
ExecStart=/home/ubuntu/viikko4/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
